# fail2ban jails for the host nginx. Installed by deploy/host/install-rate-limits.sh.
# Bans are for HTTP/HTTPS only: SSH keeps working, so a wrong ban can always be lifted with
#   sudo fail2ban-client unban <IP>        (or: sudo fail2ban-client unban --all)

[DEFAULT]
# Never ban this server itself: the cluster's uptime probes leave through its public IP.
ignoreip = 127.0.0.1/8 ::1 213.199.44.81

# More than 20 requests rejected by limit_req within a minute: a script, not a visitor
# (visitors stay inside the burst). 1 h, doubling for repeat offenders up to a week.
[nginx-limit-req]
enabled  = true
backend  = auto
port     = http,https
logpath  = /var/log/nginx/error.log
findtime = 1m
maxretry = 20
bantime  = 1h
bantime.increment = true
bantime.factor    = 2
bantime.maxtime   = 1w

# 5 probes for secrets / admin tools within 10 minutes: 24 h.
[nginx-probes]
enabled  = true
backend  = auto
port     = http,https
logpath  = /var/log/nginx/access.log
findtime = 10m
maxretry = 5
bantime  = 24h
