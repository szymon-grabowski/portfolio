---
/** Shared page shell: monitor + screen grid (header, content, optional footer). */
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Monitor from '../components/Monitor.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---
<BaseLayout title={title} description={description} noindex={noindex}>
  <Monitor>
    <div class="app">
      <Header />
      <main>
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </Monitor>
</BaseLayout>
