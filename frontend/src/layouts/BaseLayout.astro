---
import fontUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { DEFAULT_THEME, THEME_IDS, THEME_STORAGE_KEY, themesToCss } from '../data/themes';

// One variable font file (all weights), Latin only: the page has no other scripts.
const fontFace = `@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:100 800;src:url(${fontUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
import { SITE } from '../data/site';
import { BOOT_SESSION_KEY } from '../data/boot';

interface Props {
  title?: string;
}
const { title = SITE.title } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={SITE.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:global set:html={'html{background:#000}' + fontFace + themesToCss()}></style>
    <!-- Before first paint: apply the saved theme, and hide the finished boot log if it is about to animate. -->
    <script is:inline define:vars={{ ids: THEME_IDS, key: THEME_STORAGE_KEY, bootKey: BOOT_SESSION_KEY }}>
      const root = document.documentElement;
      try {
        const saved = localStorage.getItem(key);
        if (saved && ids.includes(saved)) root.dataset.theme = saved;
      } catch {}
      try {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced && sessionStorage.getItem(bootKey) !== '1') root.classList.add('boot-pending');
      } catch {}
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
