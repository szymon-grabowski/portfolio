---
import fontUrl from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { DEFAULT_THEME, THEME_IDS, THEME_STORAGE_KEY, themesToCss } from '../data/themes';

// One variable font file (all weights), Latin only: the page has no other scripts.
const fontFace = `@font-face{font-family:'JetBrains Mono';font-style:normal;font-display:swap;font-weight:100 800;src:url(${fontUrl}) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`;
import { SITE } from '../data/site';
import { BOOT_SESSION_KEY } from '../data/boot';

interface Props {
  title?: string;
  description?: string;
  /** Keep the page out of search results (404, the OG image template). */
  noindex?: boolean;
}
const { title = SITE.title, description = SITE.description, noindex = false } = Astro.props;
// Absolute URLs on the canonical origin (astro.config `site`): link previews and search engines
// always get https://szymongrabowski.dev/..., also when the page was opened on www. or next.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---
<!doctype html>
<html lang="en" data-theme={DEFAULT_THEME}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- Link previews (LinkedIn, Slack, Teams, Messenger, X). og.png: `npm run og`. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.ogSiteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <style is:global set:html={'html{background:#000}' + fontFace + themesToCss()}></style>
    <!-- Before first paint: apply the saved theme, and hide the finished boot log if it is about to animate. -->
    <script is:inline define:vars={{ ids: THEME_IDS, key: THEME_STORAGE_KEY, bootKey: BOOT_SESSION_KEY }}>
      const root = document.documentElement;
      try {
        const saved = localStorage.getItem(key);
        if (saved && ids.includes(saved)) root.dataset.theme = saved;
      } catch {}
      try {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced && sessionStorage.getItem(bootKey) !== '1') root.classList.add('boot-pending');
      } catch {}
      // Chrome aborts a cross-page view transition when the viewport resizes mid-way (mobile
      // address bar while scrolling); the page then simply appears. Keep that out of the console.
      addEventListener('pagereveal', (e) => {
        const vt = e.viewTransition;
        if (vt) for (const p of [vt.ready, vt.finished, vt.updateCallbackDone]) p.catch(() => {});
      });
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
