---
import { MODULE_COUNT, MODULE_GROUPS } from '../data/modules';
import ModuleCard from './ModuleCard.astro';

// Cards are numbered continuously across groups (01–10).
let n = 0;
const groups = MODULE_GROUPS.map((group) => ({
  ...group,
  modules: group.modules.map((module) => ({ module, number: ++n })),
}));
---
<section class="cc" aria-labelledby="cc-title">
  <div class="cc-bar">
    <a class="cc-bar__back" href="/">
      <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 6H2M6 1.5L1.5 6 6 10.5" /></svg>
      cd ..
    </a>
    <span class="cc-bar__num" aria-hidden="true">02</span>
    <h1 class="cc-bar__title" id="cc-title">COMMAND CENTER</h1>
    <div class="rule"></div>
    <span class="cc-bar__count">{MODULE_COUNT} MODULES</span>
    <div class="sep"></div>
    <span class="cc-bar__ready">READY <i aria-hidden="true"></i></span>
  </div>

  <div class="cc-groups">
    {groups.map((group) => (
      <section class:list={['cc-group', { 'cc-group--wide': group.wide }]} aria-label={group.label}>
        <h2 class="cc-group__label">{group.label}</h2>
        <div class="cc-group__grid" style={`--cols:${group.modules.length}`}>
          {group.modules.map(({ module, number }) => <ModuleCard module={module} number={number} />)}
        </div>
      </section>
    ))}
  </div>
</section>
