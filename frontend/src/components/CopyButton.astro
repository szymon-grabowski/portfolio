---
/** Icon button that copies `text` (scripts/copy-button.ts); shows a check mark for a moment. */
interface Props {
  text: string;
  /** Accessible name, e.g. "Copy email address". */
  label: string;
}
const { text, label } = Astro.props;
---
<button type="button" class="icon-btn copy-btn" data-copy={text} aria-label={label} title={label}>
  <svg class="copy-btn__icon copy-btn__icon--copy" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" />
  </svg>
  <svg class="copy-btn__icon copy-btn__icon--done" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
       stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12.5l5 5L20 6.5" /></svg>
  <span class="sr-only" data-copy-status aria-live="polite"></span>
</button>
