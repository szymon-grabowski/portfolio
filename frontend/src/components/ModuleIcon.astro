---
/**
 * Module card icon: an official brand mark (data/brand-icons.ts) or a generic
 * line icon for cards without a brand. Both use currentColor, so every icon
 * follows the active theme.
 */
import { BRAND_ICONS, type BrandIconName } from '../data/brand-icons';

const LINE_ICONS = {
  architecture: '<rect x="13" y="3" width="10" height="7" rx="1"/><rect x="3" y="24" width="10" height="7" rx="1"/><rect x="23" y="24" width="10" height="7" rx="1"/><path d="M18 10v7M8 24v-7h20v7"/>',
  document: '<path d="M9 3h13l7 7v21H9z"/><path d="M22 3v7h7M13 16h11M13 21h11M13 26h7"/>',
} as const;

export type IconName = BrandIconName | keyof typeof LINE_ICONS;

interface Props {
  name: IconName;
}
const { name } = Astro.props;
const brand = name in BRAND_ICONS ? BRAND_ICONS[name as BrandIconName] : null;
---
{brand
  ? <svg class="module-card__icon module-card__icon--brand" width="40" height="36" viewBox={brand.viewBox}
         fill="currentColor" aria-hidden="true"><path d={brand.path} /></svg>
  : <svg class="module-card__icon" width="40" height="36" viewBox="0 0 36 34" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
         set:html={LINE_ICONS[name as keyof typeof LINE_ICONS]} />}
