---
import { START_TARGET } from '../data/boot';
---
<div class="start is-visible" data-start>
  <i class="start__corner start__corner--tl"></i><i class="start__corner start__corner--tr"></i>
  <i class="start__corner start__corner--bl"></i><i class="start__corner start__corner--br"></i>
  <!-- A real link: works without JavaScript; the script adds the typing effect first. -->
  <a class="start__button" href={START_TARGET} data-astro-prefetch="load">
    START
    <svg width="32" height="20" viewBox="0 0 32 20" fill="none" stroke="currentColor" stroke-width="2.4"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2 10h27M20 2l9 8-9 8" />
    </svg>
  </a>
</div>
