---
/** Title bar of a screen: "cd .." back link, screen number and title, status and optional next screen on the right. */
interface Props {
  num: string;
  title: string;
  titleId: string;
  back: string;
  /** Right-hand text before READY, e.g. the module count. */
  info?: string;
  /** Link to a related screen after READY, styled like "cd ..". */
  next?: { href: string; num: string; label: string };
}
const { num, title, titleId, back, info, next } = Astro.props;
---
<div class="cc-bar">
  <a class="cc-bar__back" href={back}>
    <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 6H2M6 1.5L1.5 6 6 10.5" /></svg>
    cd ..
  </a>
  <span class="cc-bar__num" aria-hidden="true">{num}</span>
  <h1 class="cc-bar__title" id={titleId}>{title}</h1>
  <div class="rule"></div>
  {info && <span class="cc-bar__count">{info}</span>}
  {info && <div class="sep"></div>}
  <span class="cc-bar__ready">READY <i aria-hidden="true"></i></span>
  {next && (
    <a class="cc-bar__back cc-bar__next" href={next.href} aria-label={`cd ${next.num}: ${next.label}`}>
      cd {next.num}
      <svg width="14" height="12" viewBox="0 0 14 12" fill="none" stroke="currentColor" stroke-width="1.8"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h11M8 1.5L12.5 6 8 10.5" /></svg>
    </a>
  )}
</div>
