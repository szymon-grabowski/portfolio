{
  "ci": {
    "collect": {
      "staticDistDir": "./frontend/dist",
      "numberOfRuns": 3,
      "maxAutodiscoverUrls": 0,
      "autodiscoverUrlBlocklist": [
        "/404.html",
        "/og-image/index.html"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./frontend/.lighthouseci"
    }
  }
}
