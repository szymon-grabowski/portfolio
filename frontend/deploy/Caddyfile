# Example Caddy config for serving dist/. Replace the domain and root path.
portfolio.example.com {
	root * /srv/portfolio/dist
	encode zstd gzip

	# Hashed build assets never change: cache for a year.
	@assets path /_astro/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML must always be revalidated so new deploys show up immediately.
	@html path / /index.html
	header @html Cache-Control "no-cache"

	file_server
}
